<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
<UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><StartupObject>ScreenAgent.Program</StartupObject>
<RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><PublishTrimmed>false</PublishTrimmed>
<ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest>
</PropertyGroup>
<ItemGroup><ProjectReference Include="../ScreenAgent.Core/ScreenAgent.Core.csproj"/>
<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40"/>
<PackageReference Include="NAudio" Version="2.2.1"/>
<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/>
<PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true"/>
</ItemGroup>
<Target Name="EmbedTesseractNative" BeforeTargets="PrepareForBuild">
<ItemGroup>
<EmbeddedResource Include="$(PkgTesseract)/x64/tesseract50.dll" LogicalName="ScreenAgent.Native.tesseract50.dll"/>
<EmbeddedResource Include="$(PkgTesseract)/x64/leptonica-1.82.0.dll" LogicalName="ScreenAgent.Native.leptonica-1.82.0.dll"/>
</ItemGroup>
<Error Condition="!Exists('$(PkgTesseract)/x64/tesseract50.dll')" Text="Pinned Tesseract native package not restored"/>
</Target>
</Project>
